# The frontend imports these dependency-free shared helpers.
# Keep backend code, settings, dependencies, and tests excluded.
server/*
!server/shared/
server/shared/*
!server/shared/bannerContent.js
!server/shared/loginValidation.js
!server/shared/orderWorkflow.js

# Local submissions, QA output, and dependency caches are not deployment inputs.
/deliverables/
/tmp/
/tools/
/.venv-otp/
/node_modules/
/dist/
