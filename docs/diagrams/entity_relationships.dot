digraph schema { graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=1.2, fontname="Arial", label="Severino PostgreSQL schema — enhancement migration 001", labelloc=t, fontsize=22]; node [shape=plain, fontname="Arial"]; edge [fontname="Arial", fontsize=9, color="#6B786D", arrowsize=0.65];
