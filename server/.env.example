PORT=4000
JWT_SECRET=replace-with-strong-secret
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@severinoatelier.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Supabase Session Pooler values from Project > Connect > Session pooler
# DATABASE_URL can be used instead of the five DB_* connection fields below.
# DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.project-ref
DB_PASSWORD=replace-with-supabase-database-password
DB_NAME=postgres
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Base64-encoded Supabase server root certificate from Database Settings
DB_SSL_CA_BASE64=

# Required only while running npm run db:migrate
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=severino
MIGRATION_DNS_SERVERS=1.1.1.1,8.8.8.8

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=https://your-backend.example.com/api/auth/google/callback
PROMAILER_API_URL=https://your-promailer-send-endpoint
PROMAILER_API_KEY=your-promailer-api-key
PROMAILER_SMTP_CONNECTION_ID=your-promailer-smtp-connection-id
PROMAILER_FROM=your-email@example.com
PROMAILER_AUTH_SCHEME=Bearer
MAIL_FROM_NAME=Severino Shop
SMTP_EMAIL=your-email@example.com
SMTP_PASS=your-app-password
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-app-password
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
MAX_UPLOAD_MB=10
OTP_TTL_MS=300000
OTP_RESEND_MS=60000
OTP_MAX_ATTEMPTS=5
UPLOAD_MAX_WIDTH=1000
UPLOAD_TARGET_MAX_KB=400
UPLOAD_TARGET_MIN_KB=200
UPLOAD_FORMAT=webp
UPLOAD_START_QUALITY=80
UPLOAD_MIN_QUALITY=50
